---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, socials } from '../data/site';
---

<Base>
  <main>
    <div class="term">
      <div class="bar" aria-hidden="true">
        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        <span class="bar-title">gavin@emdashcyber:~</span>
      </div>
      <div class="content">
        <p class="prompt" aria-hidden="true">$ whoami</p>
        <h1>{site.name}</h1>
        <p class="role">{site.title}<span class="cursor" aria-hidden="true"></span></p>
        <nav aria-label="Links">
          <ul class="links">
            {
              socials.map((s) => (
                <li>
                  <a class="link" href={s.href} rel="me noopener">
                    <Icon name={s.icon} />
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>
  </main>
</Base>
