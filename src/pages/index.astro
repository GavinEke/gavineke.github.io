---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { profiles, site, socials } from '../data/site';

const profile = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: site.url,
  mainEntity: {
    '@type': 'Person',
    '@id': `${site.url}/#gavin-eke`,
    name: site.name,
    jobTitle: site.title,
    url: site.url,
    description: site.description,
    sameAs: profiles.map((profile) => profile.href),
  },
};
---

<Base>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(profile).replace(/</g, '\\u003c')} />
  <main>
    <div class="term">
      <div class="bar" aria-hidden="true">
        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        <span class="bar-title">gavin@emdashcyber:~</span>
      </div>
      <div class="content">
        <p class="prompt" aria-hidden="true">$ whoami</p>
        <h1>{site.name}</h1>
        <p class="role">{site.title}<span class="cursor" aria-hidden="true"></span></p>
        <nav aria-label="Links">
          <ul class="links">
            {
              socials.map((s) => (
                <li>
                  <a class="link" href={s.href} rel="me noopener">
                    <Icon name={s.icon} />
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <p class="projects">
          Explore my other projects at <a href={site.projectsUrl} rel="me noopener">gavin.cloud</a>
        </p>
      </div>
    </div>
  </main>
</Base>
