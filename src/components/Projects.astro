---
import { projects } from '../data/site';
---

<section class="section" id="projects" aria-labelledby="projects-title">
  <div class="container">
    <p class="eyebrow">03 / projects</p>
    <h2 class="section-title" id="projects-title">Projects</h2>
    <ul class="grid">
      {
        projects.map((p) => (
          <li class="card project">
            <h3>
              <a href={p.href} rel="noopener">
                {p.name}
                <span class="sr-only"> (opens project)</span>
              </a>
            </h3>
            <p>{p.description}</p>
            <ul class="tags" aria-label="Technologies">
              {p.tags.map((t) => <li class="tag">{t}</li>)}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
  }
  .project {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: border-color 0.2s, transform 0.2s;
  }
  .project:hover,
  .project:focus-within {
    border-color: var(--accent);
    transform: translateY(-3px);
  }
  h3 {
    font-size: 1.2rem;
  }
  h3 a {
    color: var(--text);
    text-decoration: none;
  }
  /* Stretches the link over the whole card. */
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }
  p {
    color: var(--muted);
    flex: 1;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
</style>
