---
import { site } from '../data/site';

const links = [
  { href: '#about', label: 'About' },
  { href: '#experience', label: 'Experience' },
  { href: '#projects', label: 'Projects' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="#top" aria-label={`${site.name}, back to top`}>
      <span class="brand-mark" aria-hidden="true">&gt;_</span>
      <span class="brand-name">{site.name}</span>
    </a>
    <nav class="nav" aria-label="Primary">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <button class="theme-toggle" type="button" id="theme-toggle" aria-label="Switch to light theme">
      <svg class="icon sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0-5h0v3h0V2zm0 17v3M2 12h3m14 0h3M4.9 4.9l2.1 2.1m10 10 2.1 2.1m0-14.2L17 7M7 17l-2.1 2.1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
      <svg class="icon moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
      </svg>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    min-height: var(--header-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
  }
  .brand-mark {
    font-family: var(--font-mono);
    color: var(--accent);
  }
  .nav {
    order: 3;
    width: 100%;
  }
  .nav ul {
    display: flex;
    gap: 1.25rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }
  .nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    padding: 0.5rem 0;
    display: inline-block;
  }
  .nav a:hover {
    color: var(--text);
  }
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }
  .theme-toggle:hover {
    border-color: var(--accent);
  }
  .moon {
    display: none;
  }
  :global([data-theme='light']) .sun {
    display: none;
  }
  :global([data-theme='light']) .moon {
    display: block;
  }
  @media (min-width: 40rem) {
    .nav {
      order: 0;
      width: auto;
      margin-left: auto;
    }
    .nav ul {
      padding-bottom: 0;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle');

  const sync = () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    btn?.setAttribute('aria-label', `Switch to ${next} theme`);
  };

  btn?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    sync();
  });

  sync();
</script>
