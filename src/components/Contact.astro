---
import { site, socials } from '../data/site';
import Icon from './Icon.astro';
---

<section class="section alt" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <p class="eyebrow">04 / contact</p>
    <h2 class="section-title" id="contact-title">Get in touch</h2>
    <p class="lead">
      Open to conversations about security engineering, automation and collaboration.
    </p>
    <ul class="links">
      {
        socials.map((s) => (
          <li>
            <a class="btn" href={s.href} rel="me noopener">
              <Icon name={s.icon} />
              {s.label}
            </a>
          </li>
        ))
      }
      {
        site.email && (
          <li>
            <a class="btn btn-primary" href={`mailto:${site.email}`}>
              Email me
            </a>
          </li>
        )
      }
    </ul>
  </div>
</section>

<style>
  .alt {
    background: var(--surface-2);
    border-top: 1px solid var(--border);
  }
  .lead {
    color: var(--muted);
    max-width: 36rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
</style>
